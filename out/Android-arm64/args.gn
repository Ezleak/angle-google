target_os = "android"
target_cpu = "arm64"
is_component_build = false
is_debug = false
angle_build_all = false
angle_enable_gl = false
angle_enable_vulkan = true
angle_enable_d3d9 = false
angle_enable_d3d11 = false
angle_enable_null = false
angle_enable_metal = false
angle_enable_gl_desktop_frontend = true
angle_enable_gl_desktop_backend = true
angle_enable_gl_desktop = true
angle_expose_non_conformant_extensions_and_versions = true
jobs = 4
enable_iterator_debugging = false
symbol_level = 0
use_goma = false
dcheck_always_on = false
angle_assert_always_on = false
is_clang = true
android32_ndk_api_level = 29
android64_ndk_api_level = 29
strip_debug_info = true
generate_debug_info = false
enable_resource_allowlist_generation = false
use_thin_lto = true
angle_enable_vulkan = true
angle_enable_vulkan_validation_layers = false
angle_enable_swiftshader = false
angle_enable_essl = true
angle_enable_glsl = true
angle_enable_hlsl = false
angle_expose_non_conformant_extensions_and_versions = true
build_angle_deqp_tests = false
arm_use_neon = true
arm_version = 8
angle_enable_vulkan_shared_ring_buffer_cmd_alloc = true
angle_build_tests = false
cflags_c = [
  "-Wno-unused-variable",
  "-Wno-error=unused-variable",
  "-Wno-error",
  "-O3",
  "-mllvm -polly",
  "-march=armv8-a+simd",
  "-fomit-frame-pointer",
  "-fno-semantic-interposition",
  "-mllvm -hot-cold-split=true",
  "-fdata-sections",
  "-ffunction-sections",
  "-fmerge-all-constants",
  "-ftree-vectorize",
  "-fvectorize",
  "-fslp-vectorize",
  "-pipe",
  "-integrated-as",
  "-mllvm -polly-vectorizer=stripmine",
  "-mllvm -polly-invariant-load-hoisting",
  "-mllvm -polly-run-inliner",
  "-mllvm -polly-run-dce",
  "-mllvm -polly-detect-keep-going",
  "-mllvm -polly-ast-use-context",
  "-mllvm -polly-parallel",
  "-DANGLE_ENABLE_GL_DESKTOP_BACKEND",
  "-DUNSAFE_BUFFERS_BUILD",
  "-fwhole-program-vtables",
  "-flto",
]
cflags_cc = [
  "-Wno-unused-variable",
  "-Wno-error=unused-variable",
  "-Wno-error",
  "-O3",
  "-mllvm -polly",
  "-march=armv8-a+simd+crc+fp16+dotprod+lse",
  "-fomit-frame-pointer",
  "-fno-semantic-interposition",
  "-mllvm -hot-cold-split=true",
  "-fdata-sections",
  "-ffunction-sections",
  "-fmerge-all-constants",
  "-ftree-vectorize",
  "-fvectorize",
  "-fslp-vectorize",
  "-pipe -integrated-as",
  "-mllvm -polly-vectorizer=stripmine",
  "-mllvm -polly-invariant-load-hoisting",
  "-mllvm -polly-run-inliner",
  "-mllvm -polly-run-dce",
  "-mllvm -polly-detect-keep-going",
  "-mllvm -polly-ast-use-context",
  "-mllvm -polly-parallel",
  "-stdlib=libc++",
  "-DANGLE_ENABLE_GL_DESKTOP_BACKEND",
  "-DUNSAFE_BUFFERS_BUILD",
  "-fwhole-program-vtables",
]
ldflags = [
  "-fuse-ld=lld",
  "-Wl,-z,max-page-size=16384",
  "-Wl,--gc-sections",
]
treat_warnings_as_errors = false
angle_enable_glsl = true
angle_enable_hlsl = true
# Shader fix
angle_use_spirv_gen_through_glslang = true

# Enable using Vulkan to collect system info as a fallback.
angle_enable_vulkan_system_info = true

# Link in system libGL, to work with apitrace.  See doc/DebuggingTips.md.
angle_link_glx = true

# Disable histogram/protobuf support
angle_has_histograms = false
angle_has_rapidjson = false
angle_ir = true
